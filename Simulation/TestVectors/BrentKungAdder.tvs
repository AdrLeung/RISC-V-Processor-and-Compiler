# Test Vector Stimulus File for BrentKungAdder (N=8)
# Format: A[7:0] B[7:0] Cin | Expected S[7:0] Expected Cout
# Values in binary: A B Cin S Cout

# Basic cases
00000000 00000000 0 00000000 0  # 0 + 0 + 0 = 0
00000000 00000000 1 00000001 0  # 0 + 0 + 1 = 1
00000001 00000001 0 00000010 0  # 1 + 1 = 2
00000001 00000001 1 00000011 0  # 1 + 1 + 1 = 3

# No carry out
00001111 00000001 0 00010000 0  # 15 + 1 = 16
01010101 00101010 0 01111111 0  # 85 + 42 = 127
01111111 00000000 1 10000000 0  # 127 + 0 + 1 = 128

# Carry out cases
11111111 00000001 0 00000000 1  # 255 + 1 = 256 (overflow)
11111111 11111111 0 11111110 1  # 255 + 255 = 510 (overflow)
11111111 11111111 1 11111111 1  # 255 + 255 + 1 = 511 (overflow)
10000000 10000000 0 00000000 1  # 128 + 128 = 256 (overflow)
11111111 00000000 1 00000000 1  # 255 + 0 + 1 = 256 (overflow)

# Alternating bit patterns
10101010 01010101 0 11111111 0  # 0xAA + 0x55 = 0xFF
10101010 01010101 1 00000000 1  # 0xAA + 0x55 + 1 = overflow
01010101 01010101 0 10101010 0  # 0x55 + 0x55 = 0xAA

# Random values
00111100 01001011 0 10000111 0  # 60 + 75 = 135
01111010 10001011 1 00000110 1  # 122 + 139 + 1 = 262 (overflow)
00010010 00110100 0 01000110 0  # 18 + 52 = 70
11101111 00010001 0 00000000 1  # 239 + 17 = 256 (overflow)
01100100 01100100 0 11001000 0  # 100 + 100 = 200
